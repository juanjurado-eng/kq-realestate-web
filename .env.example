# El contenedor recibe estas variables desde el docker-compose (que a su vez
# las toma del .env del stack). No es necesario crear este archivo en el VPS.
PGHOST=postgres
PGPORT=5432
PGDATABASE=n8n
PGUSER=__desde_stack__
PGPASSWORD=__desde_stack__
SESSION_SECRET=__cadena_larga_aleatoria__
NODE_ENV=production
PORT=3000
